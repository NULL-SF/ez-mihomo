# source ./proxy.env 开启；source ./proxy.env off 关闭。
# 作用于当前终端后续运行的命令及其子进程。需 Bash 4.3 或更新版本。
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  printf '请使用 source %s [off]，bash 执行不能修改当前终端。\n' "$0" >&2
  exit 1
fi

_mihomo_terminal_main() {
  local IFS=$' \t\n'
  local root="${BASH_SOURCE[0]%/*}" mode="${1:-on}" name value flags decl
  local names=(HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy NO_PROXY no_proxy
               PROXYCHAINS_CONF_FILE PROXYCHAINS_QUIET_MODE)
  [[ "$root" != "${BASH_SOURCE[0]}" ]] || root=.
  root="$(cd -- "$root" && pwd -P)" || return 1
  case "$mode" in on|off) ;; *) printf '用法: source %s [off]\n' "${BASH_SOURCE[0]}" >&2; return 1 ;; esac
  if [[ "$mode" == on ]]; then
    if [[ "$root/lib/libproxychains4.so" == *[[:space:]:]* ]]; then
      printf 'ProxyChains 库路径不能包含空白或冒号，请将项目放到不含这些字符的目录。\n' >&2
      return 1
    fi
    local preload_parts=() preload_part
    IFS=$' :\t' read -ra preload_parts <<< "${LD_PRELOAD:-}"
    for preload_part in "${preload_parts[@]}"; do
      if [[ "$preload_part" == */libproxychains4.so && "$preload_part" != "$root/lib/libproxychains4.so" ]]; then
        printf '请先关闭当前 Shell 中其他项目的 ProxyChains 注入，再启用本项目。\n' >&2
        return 1
      fi
    done
  fi
  # 先检查可写性，避免只修改了一半环境却报告成功。
  for name in LD_PRELOAD _MIHOMO_PROXY_SNAPSHOT "${names[@]}"; do
    decl="$(declare -p "$name" 2>/dev/null)" || continue
    flags="${decl#declare -}"; flags="${flags%% *}"
    if [[ "${flags//[x-]/}" != "" ]]; then
      printf '无法切换代理：变量 %s 必须是可写的普通字符串，不能带整数、大小写转换、只读、数组或引用属性。\n' "$name" >&2
      return 1
    fi
  done
  source "${root}/scripts/terminal-env.sh" || return 1
  if [[ -n "${_MIHOMO_PROXY_ROOT:-}" && "$_MIHOMO_PROXY_ROOT" != "$root" ]]; then
    printf '请先关闭 %s/proxy.env 的终端代理。\n' "$_MIHOMO_PROXY_ROOT" >&2
    return 1
  fi
  # Bash arrays are not exported. Rebuild them from the inherited data snapshot,
  # never by evaluating shell text, before either on or off can change variables.
  if [[ -z "${_MIHOMO_PROXY_ROOT:-}" && -n "${_MIHOMO_PROXY_SNAPSHOT:-}" ]]; then
    local inherited=() field index=0
    while IFS= read -r -d '' field; do inherited+=("$field"); done < <(
      _mihomo_remove_preload "$root" && python3 "${root}/scripts/proxy_snapshot.py" decode "$root"
    )
    if [[ "${#inherited[@]}" != "$(( ${#names[@]} * 3 + 4 ))" || "${inherited[${#inherited[@]}-1]:-}" != ok ]]; then
      printf '未能恢复继承的代理快照，当前终端环境未修改。\n' >&2
      return 1
    fi
    declare -gA _MIHOMO_PROXY_SAVED_SET=() _MIHOMO_PROXY_SAVED_VALUE=() _MIHOMO_PROXY_SAVED_EXPORT=()
    for name in "${names[@]}"; do
      _MIHOMO_PROXY_SAVED_SET[$name]="${inherited[index]}"
      _MIHOMO_PROXY_SAVED_EXPORT[$name]="${inherited[index+1]}"
      _MIHOMO_PROXY_SAVED_VALUE[$name]="${inherited[index+2]}"
      index=$((index+3))
    done
    _MIHOMO_PROXY_PRELOAD_SET="${inherited[index]}"
    _MIHOMO_PROXY_PRELOAD_EXPORTED="${inherited[index+1]}"
    _MIHOMO_PROXY_PRELOAD_ORIGINAL="${inherited[index+2]}"
    _MIHOMO_PROXY_ROOT="$root"
  fi
  if [[ "$mode" == off ]]; then
    _mihomo_remove_preload "$root" || return 1
    if [[ "${_MIHOMO_PROXY_ROOT:-}" == "$root" ]]; then
      for name in "${names[@]}"; do
        # 旧版本快照没有 NO_PROXY/no_proxy 条目时，不删除用户原有变量。
        [[ -v _MIHOMO_PROXY_SAVED_SET[$name] ]] || continue
        if [[ "${_MIHOMO_PROXY_SAVED_SET[$name]:-0}" == 1 ]]; then
          printf -v "$name" '%s' "${_MIHOMO_PROXY_SAVED_VALUE[$name]}"
          if [[ "${_MIHOMO_PROXY_SAVED_EXPORT[$name]:-0}" == 1 ]]; then
            export "$name"
          else
            export -n "$name"
          fi
        else
          unset "$name"
        fi
      done
      local original_preloads=() current_preloads=()
      IFS=$' :\t' read -ra original_preloads <<< "$_MIHOMO_PROXY_PRELOAD_ORIGINAL"
      IFS=$' :\t' read -ra current_preloads <<< "${LD_PRELOAD:-}"
      if [[ "${original_preloads[*]}" == "${current_preloads[*]}" ]]; then
        if [[ "$_MIHOMO_PROXY_PRELOAD_SET" == 1 ]]; then
          LD_PRELOAD="$_MIHOMO_PROXY_PRELOAD_ORIGINAL"
          if [[ "$_MIHOMO_PROXY_PRELOAD_EXPORTED" == 1 ]]; then
            export LD_PRELOAD
          else
            export -n LD_PRELOAD
          fi
        else
          unset LD_PRELOAD
        fi
      fi
      unset _MIHOMO_PROXY_ROOT _MIHOMO_PROXY_SAVED_SET _MIHOMO_PROXY_SAVED_VALUE _MIHOMO_PROXY_SAVED_EXPORT
      unset _MIHOMO_PROXY_PRELOAD_ORIGINAL _MIHOMO_PROXY_PRELOAD_EXPORTED _MIHOMO_PROXY_PRELOAD_SET
      unset _MIHOMO_PROXY_SNAPSHOT
      printf '%s\n' '已清除当前终端的代理注入，恢复启用代理前的终端环境。'
    else
      printf '%s\n' '当前 Shell 未保存启用代理前的环境；已清理本项目的 ProxyChains 设置，代理变量保持不变。'
    fi
    return 0
  fi
  [[ -r "${root}/lib/libproxychains4.so" ]] || {
    printf '未找到库文件: %s/lib/libproxychains4.so\n' "$root" >&2; return 1;
  }
  # 预加载库先于子 Bash 初始化；须在 exec 前移除，避免损坏配置阻止管理入口启动。
  # 此处只清理子环境，不改变当前终端及其恢复快照。
  local PROXY_PORT checked_ports
  checked_ports="$( _mihomo_remove_preload "$root" && bash "${root}/client.sh" __write_proxychains )" || return 1
  IFS=' ' read -r PROXY_PORT <<< "$checked_ports"
  # 重复启用时保留第一次启用前的快照，不把已注入的环境保存成原环境。
  if [[ -z "${_MIHOMO_PROXY_ROOT:-}" ]]; then
    _MIHOMO_PROXY_PRELOAD_ORIGINAL="$( _mihomo_remove_preload "$root"; printf '%s' "${LD_PRELOAD:-}" )"
    _MIHOMO_PROXY_PRELOAD_SET=0
    if [[ -v LD_PRELOAD && ( -n "$_MIHOMO_PROXY_PRELOAD_ORIGINAL" || -z "$LD_PRELOAD" ) ]]; then
      _MIHOMO_PROXY_PRELOAD_SET=1
    fi
    decl="$(declare -p LD_PRELOAD 2>/dev/null)" || decl=''
    flags="${decl#declare -}"; flags="${flags%% *}"
    _MIHOMO_PROXY_PRELOAD_EXPORTED=0
    [[ "$_MIHOMO_PROXY_PRELOAD_SET" != 1 || "$flags" != *x* ]] || _MIHOMO_PROXY_PRELOAD_EXPORTED=1
    declare -gA _MIHOMO_PROXY_SAVED_SET=() _MIHOMO_PROXY_SAVED_VALUE=() _MIHOMO_PROXY_SAVED_EXPORT=()
  fi
  for name in "${names[@]}"; do
    [[ -v _MIHOMO_PROXY_SAVED_SET[$name] ]] && continue
    _MIHOMO_PROXY_SAVED_SET[$name]=0
    _MIHOMO_PROXY_SAVED_EXPORT[$name]=0
    _MIHOMO_PROXY_SAVED_VALUE[$name]=''
    # 子 Bash 只继承注入后的环境；不能把本项目的配置误认为用户原有配置。
    if [[ "$name" == PROXYCHAINS_* && ( "${PROXYCHAINS_CONF_FILE:-}" == "${root}/runtime/proxychains.conf" || "${PROXYCHAINS_CONF_FILE:-}" == "${root}/tmp/proxychains.conf" ) ]]; then
      continue
    fi
    if [[ -v "$name" ]]; then
      _MIHOMO_PROXY_SAVED_SET[$name]=1
      _MIHOMO_PROXY_SAVED_VALUE[$name]="${!name}"
      decl="$(declare -p "$name")"
      flags="${decl#declare -}"; flags="${flags%% *}"
      [[ "$flags" != *x* ]] || _MIHOMO_PROXY_SAVED_EXPORT[$name]=1
    fi
  done
  # Carry the original state through child processes. Repeated on preserves the
  # first snapshot instead of taking a snapshot of an already proxied shell.
  local snapshot
  snapshot="$(
    {
      for name in "${names[@]}"; do
        printf '%s\0' "${_MIHOMO_PROXY_SAVED_SET[$name]}" "${_MIHOMO_PROXY_SAVED_EXPORT[$name]}" "${_MIHOMO_PROXY_SAVED_VALUE[$name]}"
      done
      printf '%s\0' "$_MIHOMO_PROXY_PRELOAD_SET" "$_MIHOMO_PROXY_PRELOAD_EXPORTED" "$_MIHOMO_PROXY_PRELOAD_ORIGINAL"
    } | ( _mihomo_remove_preload "$root" && python3 "${root}/scripts/proxy_snapshot.py" encode "$root" )
  )" || return 1
  export _MIHOMO_PROXY_SNAPSHOT="$snapshot"
  _MIHOMO_PROXY_ROOT="$root"
  _mihomo_remove_preload "$root" || return 1
  export PROXYCHAINS_CONF_FILE="${root}/runtime/proxychains.conf" PROXYCHAINS_QUIET_MODE=1
  export LD_PRELOAD="${root}/lib/libproxychains4.so${LD_PRELOAD:+:${LD_PRELOAD}}"
  export http_proxy="http://127.0.0.1:${PROXY_PORT}" HTTP_PROXY="http://127.0.0.1:${PROXY_PORT}"
  export https_proxy="$http_proxy" HTTPS_PROXY="$http_proxy"
  export all_proxy="socks5h://127.0.0.1:${PROXY_PORT}" ALL_PROXY="socks5h://127.0.0.1:${PROXY_PORT}"
  # 两种大小写合并，保持已有例外；ProxyChains 只单独放行本机回环。
  local bypass="localhost,127.0.0.1,::1" item previous
  previous="${_MIHOMO_PROXY_SAVED_VALUE[no_proxy]:-},${_MIHOMO_PROXY_SAVED_VALUE[NO_PROXY]:-}"
  local bypass_items=()
  IFS=',' read -ra bypass_items <<< "$previous"
  for item in "${bypass_items[@]}"; do
    [[ -z "$item" || ",$bypass," == *",$item,"* ]] || bypass+=",$item"
  done
  export no_proxy="$bypass" NO_PROXY="$bypass"
  printf '当前终端已配置 SOCKS / HTTP 混合代理 127.0.0.1:%s 及 ProxyChains。恢复：source %s/proxy.env off\n' "$PROXY_PORT" "$root"
}

if _mihomo_terminal_main "$@"; then
  unset -f _mihomo_terminal_main _mihomo_remove_preload _mihomo_load_ports _mihomo_ensure_ports _mihomo_check_running_ports _mihomo_check_available_ports _mihomo_check_ports
  return 0
else
  unset -f _mihomo_terminal_main _mihomo_remove_preload _mihomo_load_ports _mihomo_ensure_ports _mihomo_check_running_ports _mihomo_check_available_ports _mihomo_check_ports
  return 1
fi
